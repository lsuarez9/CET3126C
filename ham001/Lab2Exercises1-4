#include <stdio.h>
#include <limits.h>
#include <float.h>

int main() {
    printf("========================================\n");
    printf("Exercise 1: Data Type Sizes and Limits\n");
    printf("========================================\n\n");
    
    // Declare variables
    int i;
    short s;
    long l;
    unsigned int ui;
    float f;
    double d;
    char c;
    
    // Print sizes
    printf("Size of int: %lu bytes\n", sizeof(int));
    printf("Size of short: %lu bytes\n", sizeof(short));
    printf("Size of long: %lu bytes\n", sizeof(long));
    printf("Size of unsigned int: %lu bytes\n", sizeof(unsigned int));
    printf("Size of float: %lu bytes\n", sizeof(float));
    printf("Size of double: %lu bytes\n", sizeof(double));
    printf("Size of char: %lu bytes\n\n", sizeof(char));
    
    // Print limits
    printf("int range: %d to %d\n", INT_MIN, INT_MAX);
    printf("short range: %d to %d\n", SHRT_MIN, SHRT_MAX);
    printf("long range: %ld to %ld\n", LONG_MIN, LONG_MAX);
    printf("unsigned int range: 0 to %u\n", UINT_MAX);
    printf("float range: %e to %e\n", FLT_MIN, FLT_MAX);
    printf("double range: %e to %e\n", DBL_MIN, DBL_MAX);
    printf("char range: %d to %d\n\n", CHAR_MIN, CHAR_MAX);
    
    
    printf("========================================\n");
    printf("Exercise 2: Type Conversion\n");
    printf("========================================\n\n");
    
    // 1. Implicit conversion (int to float)
    int num1 = 42;
    float result1 = num1;  // Implicit conversion
    printf("1. Implicit conversion:\n");
    printf("   int %d converted to float: %.2f\n\n", num1, result1);
    
    // 2. Explicit conversion (float to int)
    float num2 = 3.14159;
    int result2 = (int)num2;  // Explicit conversion (casting)
    printf("2. Explicit conversion:\n");
    printf("   float %.5f converted to int: %d\n\n", num2, result2);
    
    // 3. Char to ASCII value
    char letter = 'A';
    int ascii_value = letter;  // Implicit conversion
    printf("3. Char to ASCII:\n");
    printf("   char '%c' has ASCII value: %d\n\n", letter, ascii_value);
    
    
    printf("========================================\n");
    printf("Exercise 3: Integer Overflow and Precision Loss\n");
    printf("========================================\n\n");
    
    // 1. Integer overflow
    unsigned int max_uint = UINT_MAX;
    printf("1. Integer overflow:\n");
    printf("   UINT_MAX = %u\n", max_uint);
    printf("   UINT_MAX + 1 = %u (wraps around to 0)\n\n", max_uint + 1);
    
    // 2. Float precision loss
    float large_float = 1.0e20;
    float result_float = large_float + 1.0;
    printf("2. Float precision loss:\n");
    printf("   Large float: %.2e\n", large_float);
    printf("   Large float + 1.0: %.2e\n", result_float);
    printf("   Notice: Adding 1.0 has no effect due to precision limits!\n\n");
    
    
    printf("========================================\n");
    printf("Exercise 4: Mixing Data Types in Math\n");
    printf("========================================\n\n");
    
    // 1. Adding int and float
    int int_num = 10;
    float float_num = 3.5;
    float mixed_result1 = int_num + float_num;
    printf("1. int + float:\n");
    printf("   %d + %.1f = %.1f\n", int_num, float_num, mixed_result1);
    printf("   Explanation: int is converted to float, result is float\n\n");
    
    // 2. Adding char and int
    char char_letter = 'A';
    int int_value = 5;
    int mixed_result2 = char_letter + int_value;
    printf("2. char + int:\n");
    printf("   '%c' (ASCII %d) + %d = %d\n", char_letter, (int)char_letter, int_value, mixed_result2);
    printf("   Explanation: char is converted to its ASCII value (%d), then added\n", (int)char_letter);
    printf("   Result %d corresponds to character '%c'\n\n", mixed_result2, (char)mixed_result2);
    
    printf("========================================\n");
    printf("Summary: When mixing types, C promotes to the larger/more precise type\n");
    printf("========================================\n");
    
    return 0;
}
